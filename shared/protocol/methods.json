        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 400
          },
          "all": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "notif.open": {
      "risk": "nav",
      "summary": "Open a notification (as if tapped).",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
