        ]
      }
    },
    "media.now_playing": {
      "risk": "read",
      "summary": "What is playing: app, title, artist, state, position (needs notification access).",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "call.control": {
      "risk": "local",
      "summary": "Answer/end the current call or toggle speaker/mute.",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "answer",
              "end",
              "speaker_on",
              "speaker_off",
              "mute",
              "unmute"
            ]
          }
        },
        "required": [
          "action"
        ]
      }
    },
    "usage.stats": {
      "risk": "read",
      "summary": "Screen time per app (needs Usage access).",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "period": {
            "enum": [
              "today",
              "yesterday",
              "week"
            ],
            "default": "today"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 8
          }
        }
      }
    },
    "ui.text": {
      "risk": "read",
      "summary": "All visible text on screen in reading order (passwords excluded).",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxChars": {
            "type": "integer",
            "minimum": 200,
            "maximum": 20000,
            "default": 6000
          }
        }
      }
    },
    "ui.scroll_to": {
      "risk": "nav",
      "summary": "Scroll until an element with this text is visible.",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "direction": {
            "enum": [
              "down",
              "up"
            ],
            "default": "down"
          },
          "maxScrolls": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 10
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "rec.start": {
      "risk": "read",
      "summary": "Teach mode: start recording the user's taps and typing.",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "rec.stop": {
      "risk": "read",
      "summary": "Teach mode: stop recording and return the steps.",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cancel": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "nixin.notify": {
      "risk": "local",
      "summary": "Show a notification on the phone (reminders, messages from the PC).",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "text": {
            "type": "string",
            "maxLength": 1000
          },
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          }
        },
        "required": [
          "title"
        ]
      }
    }
