        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ms": {
            "type": "integer",
            "minimum": 50,
            "maximum": 5000,
            "default": 500
          }
        }
      }
    },
    "device.wallpaper": {
      "risk": "local",
      "summary": "Set the wallpaper from a JPEG/PNG image.",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "string",
            "maxLength": 12000000
          },
          "target": {
            "enum": [
              "home",
              "lock",
              "both"
