        "type": "object",
        "additionalProperties": false,
        "properties": {
          "transferId": {
            "type": "string",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "mime": {
            "type": "string",
            "maxLength": 100
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "data": {
            "type": "string",
            "maxLength": 800000
          }
        },
        "required": [
          "transferId",
          "name",
          "index",
          "total",
          "data"
        ]
      }
    },
    "notif.reply": {
      "risk": "external",
      "summary": "Reply to a notification through its own reply action (WhatsApp, Telegram, SMS...).",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 400
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "key",
          "text"
        ]
      }
    },
    "notif.dismiss": {
      "risk": "local",
      "summary": "Dismiss a notification (or all).",
