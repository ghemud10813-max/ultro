# Nixin API keys. Copy to .env (never commit it). All of these have free tiers.
# Only GROQ is needed to start; the others are optional fallbacks.

# https://console.groq.com/keys  — LLMs (gpt-oss-20b/120b, qwen) + Whisper speech-to-text
GROQ_API_KEY=

# Several keys you legitimately own (e.g. separate projects) can be pooled:
# GROQ_API_KEYS=key_one,key_two

# https://cloud.cerebras.ai  — fast gpt-oss-120b fallback
CEREBRAS_API_KEY=

# https://aistudio.google.com/apikey  — Gemini flash / flash-lite (text + vision)
GEMINI_API_KEY=

# https://openrouter.ai/keys  — ":free" models
OPENROUTER_API_KEY=

# https://dash.cloudflare.com  — Workers AI (needs account id too)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
