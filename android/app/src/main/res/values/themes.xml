<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window theme only sets the background before first frame. -->
    <style name="Theme.Nixin" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nixin_bg</item>
        <item name="android:colorAccent">@color/nixin_accent</item>
    </style>

    <style name="Theme.Nixin.Translucent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:colorAccent">@color/nixin_accent</item>
    </style>
</resources>
